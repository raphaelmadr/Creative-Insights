generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model NewsInsight {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
}

model Creator {
  id        String  @id @default(cuid())
  name      String
  acronym   String  @unique
  active    Boolean @default(true)
  avatarUrl String? @db.Text

  /// Conta Google desta pessoa, quando ela tem uma.
  ///
  /// O nome e a foto passam a vir daí, em vez de digitados e colados à mão no
  /// painel. É opcional de propósito: a SIGLA é que liga o criativo ao seu
  /// dono, e há criadores sem conta — quem nunca teve e-mail corporativo, e o
  /// balde de "sem atribuição", que não é pessoa nenhuma.
  userEmail String? @unique

  monthlyGoal       Float                  @default(50000)
  monthlyVolumeGoal Int                    @default(30)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  reports           CreatorMonthlyReport[]
  deliveries        Delivery[]
}

model CreatorMonthlyReport {
  id                String   @id @default(cuid())
  creatorId         String
  month             Int // 1 a 12
  year              Int // ex: 2026
  grossValue        Float    @default(0)
  riskApprovedValue Float    @default(0)
  spend             Float    @default(0)
  purchases         Int      @default(0)
  netOrders         Int      @default(0)
  roas              Float    @default(0)
  activeAdsCount    Int      @default(0)
  deliveredPieces   Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  creator           Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, month, year])
}

model Delivery {
  id        String   @id @default(cuid())
  slackTs   String   @unique // ID único da mensagem no Slack (timestamp)
  creatorId String
  pieces    Int
  date      DateTime
  text      String?  @db.Text // A mensagem original do Slack
  createdAt DateTime @default(now())

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

model AlgorithmUpdate {
  id           String   @id @default(uuid())
  title        String
  content      String   @db.Text
  urgency      String   @default("Baixa")
  category     String   @default("Geral")
  sourceUrl    String?
  thumbnailUrl String?
  timestamp    DateTime @default(now())
  createdAt    DateTime @default(now())
}

model AdCreative {
  id                 String    @id
  adName             String
  adsetName          String
  campaignName       String
  designer           String?
  imageUrl           String?   @db.Text
  thumbnailUrl       String?   @db.Text
  videoUrl           String?   @db.Text
  mediaType          String    @default("image")
  publisherPlatforms String?
  platform           String    @default("META") // "META", "TIKTOK", "GOOGLE"
  status             String?
  createdTime        DateTime?

  /// Transcrição visual gerada pela IA a partir da própria imagem: textos,
  /// headline, CTA, cores e elementos. É a base das análises individuais e das
  /// comparações de similaridade — analisar pelo nome do arquivo não descreve
  /// o criativo. Gerada sob demanda e cacheada aqui.
  visionTranscript String?   @db.Text
  visionAnalyzedAt DateTime?

  /// Análise da peça escrita pela IA — transcrição, análise e melhorias —, o
  /// texto exato que o cartão mostra. Cacheada aqui porque cada clique em
  /// "Analisar" gastava uma chamada nova ao modelo para uma peça que não muda:
  /// caro e lento. Só é regerada quando alguém pede a refação explicitamente.
  aiAnalysis   String?   @db.Text
  aiAnalyzedAt DateTime?

  metrics AdDailyMetrics[]
}

model AdDailyMetrics {
  id                String   @id @default(uuid())
  adCreativeId      String
  date              DateTime
  spend             Float
  roas              Float
  cpm               Float
  ctr               Float
  cpc               Float    @default(0)
  impressions       Int      @default(0)
  reach             Int      @default(0)
  frequency         Float    @default(0)
  clicks            Int      @default(0)
  purchases         Int      @default(0)
  netOrders         Int      @default(0)
  riskApprovedValue Float    @default(0)
  grossValue        Float    @default(0)
  messages          Int      @default(0)

  // Métricas Extras (Engajamento / Retenção)
  likes          Int        @default(0)
  comments       Int        @default(0)
  shares         Int        @default(0)
  videoViews     Int        @default(0)
  videoViews25p  Int        @default(0)
  videoViews50p  Int        @default(0)
  videoViews75p  Int        @default(0)
  videoViews100p Int        @default(0)
  creative       AdCreative @relation(fields: [adCreativeId], references: [id], onDelete: Cascade)

  @@unique([adCreativeId, date])
}

model SystemSettings {
  id Int @id @default(1)

  // Metas Gerais
  teamCreativeGoal Int @default(300)

  // Metas de Performance (ROAS / CPA)
  superWinnerSpend  Float @default(1000)
  superWinnerReturn Float @default(5000)
  superWinnerCpa    Float @default(50)
  winnerSpend       Float @default(1000)
  winnerReturn      Float @default(1000)
  winnerCpa         Float @default(60)

  creativeCategories String? @db.Text

  hypothesisPrompt     String? @db.Text
  visionPrompt         String? @db.Text // Instrução de transcrição da imagem
  andromedaPrompt      String? @db.Text
  tavilySearchQuery    String? @db.Text
  marketInsightsPrompt String? @db.Text

  /// SEM USO desde a reversão dos limites de caracteres do gerador de copy.
  ///
  /// Guardava um orçamento por formato que o prompt impunha. A régua saiu: com
  /// o corpo espremido, a copy virava etiqueta de preço e perdia o argumento —
  /// o comprimento certo é o das peças que converteram, não um número redondo.
  /// A coluna fica porque tem valores digitados à mão; pode ser derrubada.
  copyCharLimits String? @db.Text

  metaAdAccountId String?
  metaAppId       String?
  metaAppSecret   String? @db.Text
  metaAccessToken String? @db.Text

  // IDs das conversões personalizadas da conta. Ver lib/meta-conversions.ts:
  // definem CPA, Receita Líquida e as categorias de winner.
  metaRiskApprovedConversionId    String?
  metaPaymentApprovedConversionId String?

  tiktokAdvertiserId String?
  tiktokAppId        String?
  tiktokAppSecret    String? @db.Text
  tiktokAccessToken  String? @db.Text

  googleClientId     String? @db.Text
  googleClientSecret String? @db.Text
  nextAuthSecret     String? @db.Text
  nextAuthUrl        String?

  geminiApiKey      String? @db.Text
  openaiApiKey      String? @db.Text
  anthropicApiKey   String? @db.Text
  tavilyApiKey      String? @db.Text
  groqApiKey        String? @db.Text
  openRouterApiKey  String? @db.Text
  cohereApiKey      String? @db.Text
  huggingFaceApiKey String? @db.Text
  slackBotToken     String?
  slackChannelId    String?

  cpanelUploadUrl    String? @db.Text
  cpanelUploadSecret String? @db.Text

  cronSyncEnabled  Boolean @default(true)
  cronSyncInterval Int     @default(120) // Intervalo em minutos
  cronSecret       String? @db.Text // Gerado no painel; autoriza o disparador externo

  lastSyncAt      DateTime? // Fim da última sincronização, manual ou automática
  lastCronSyncAt  DateTime? // Início da última passada de métricas; base do portão de intervalo
  lastMediaSyncAt DateTime? // Início da última passada de mídia; o cron alterna entre as duas
  updatedAt       DateTime  @updatedAt
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String // "INFO", "WARNING", "ERROR"
  source    String // "FRONTEND", "BACKEND", "CRON", "SYNC", etc.
  message   String   @db.Text
  stack     String?  @db.Text
  url       String? // A URL onde o erro ocorreu (se aplicável)
  createdAt DateTime @default(now())
}

model MonthlyGoal {
  id          String   @id @default(uuid())
  month       Int
  year        Int
  spendGoal   Float    @default(0)
  revenueGoal Float    @default(0)
  cpaGoal     Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([month, year])
}

// --- NEXTAUTH MODELS ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  /// "ADMIN" dá acesso ao painel de configurações — metas, credenciais das
  /// APIs, prompts de IA e logs. "MEMBER" é todo o resto do produto.
  /// Guardado como texto e não como enum porque o vocabulário do papel é lido
  /// por middleware e por rotas que não carregam o client do Prisma.
  role String @default("MEMBER")

  /// Último sinal de vida da pessoa, atualizado pelo heartbeat de presença.
  /// Quem aparece "online" no topo é quem tem este campo dentro da janela
  /// definida em `lib/presence.ts` — não existe conexão aberta para consultar.
  lastSeenAt DateTime?

  /// Preferências da pessoa em JSON: tema e os filtros do painel. Em JSON, e
  /// não em colunas, porque o conjunto de filtros muda junto com a interface e
  /// cada mudança viraria uma migração — ver `lib/user-preferences.ts`, que é
  /// quem define e valida a forma deste campo.
  preferences String? @db.Text

  accounts Account[]
  sessions Session[]

  @@index([lastSeenAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// MÓDULO CREATOR — Kanban de demandas e gerador de copy
//
// Vive no mesmo banco e no mesmo aplicativo que o painel de performance porque
// a proposta é justamente parar de pular entre ferramentas: a demanda nasce
// aqui, o criador entrega aqui, e a copy é escrita com os dados de performance
// que já estão a uma consulta de distância.
// ---------------------------------------------------------------------------

/// Um quadro — um fluxo de trabalho, com as suas colunas e os seus campos.
///
/// São vários de propósito: "Criativos", "Copy", "Social" têm etapas e
/// perguntas diferentes, e um quadro único obrigaria todos a preencher o
/// formulário do outro.
model Board {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  position    Int     @default(0)
  archived    Boolean @default(false)

  /// O quadro para onde as copys geradas caem automaticamente.
  ///
  /// Só um vale por vez — a rota que gera a copy precisa de um destino certo,
  /// sem perguntar, e "escolha o quadro" a cada geração é atrito para uma
  /// decisão que muda uma vez por ano. Ver `lib/kanban.ts`.
  receivesCopy Boolean @default(false)

  /// Quais atributos embutidos cada card mostra na frente, em JSON
  /// (`["priority","dueDate"]`).
  ///
  /// Nulo é "nunca configurado", e vale o conjunto padrão; a lista vazia é uma
  /// escolha, e significa nenhum. Ver `parseCardBadges` em `lib/kanban.ts`.
  cardBadges String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  columns BoardColumn[]
  fields  BoardField[]
  cards   BoardCard[]
}

/// Uma etapa do fluxo. A ordem na tela é `position`, não a data de criação.
model BoardColumn {
  id       String @id @default(cuid())
  boardId  String
  name     String
  position Int    @default(0)

  /// Token semântico da cor do topo da coluna (ex.: `var(--warning)`).
  color String?

  /// A coluna onde cai tudo que chega pelo formulário e pelo gerador de copy.
  ///
  /// Sem ela a demanda nova precisaria adivinhar uma coluna, e "a primeira"
  /// quebra no dia em que alguém reordenar o quadro.
  isIntake Boolean @default(false)

  /// A coluna que significa "entregue" — é dela que sai a contagem de
  /// concluídos e o tempo de ciclo do card.
  isDone Boolean @default(false)

  /// Limite de cards simultâneos. Nulo é sem limite; o quadro avisa, não bloqueia.
  wipLimit Int?

  board Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards BoardCard[]

  @@index([boardId])
}

/// Um campo definível do formulário daquele quadro.
///
/// É o que permite a cada time perguntar o que de fato precisa saber sem que
/// alguém mexa no código: o formulário de entrada e o verso do card são
/// gerados a partir desta tabela. Ver `lib/kanban.ts` para os tipos aceitos.
model BoardField {
  id      String @id @default(cuid())
  boardId String
  label   String

  /// Chave estável usada no JSON de valores do card.
  ///
  /// Separada do rótulo porque renomear "Prazo" para "Data de entrega" não
  /// pode apagar o que já foi respondido em cem cards.
  key String

  /// TEXT, TEXTAREA, SELECT, MULTISELECT, NUMBER, DATE, URL ou CHECKBOX.
  type String @default("TEXT")

  /// Opções do SELECT/MULTISELECT, em JSON. Vazio nos demais tipos.
  options String? @db.Text

  placeholder String?
  helpText    String? @db.Text
  required    Boolean @default(false)

  /// Mostrar o valor na frente do card, sem precisar abri-lo.
  showOnCard Boolean @default(false)

  position Int @default(0)

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, key])
  @@index([boardId])
}

/// Uma demanda.
model BoardCard {
  id          String  @id @default(cuid())
  boardId     String
  columnId    String
  title       String
  description String? @db.Text

  /// Ordem dentro da coluna. Reescrita em bloco a cada arrasto.
  position Int @default(0)

  /// BAIXA, MEDIA, ALTA ou URGENTE.
  priority String @default("MEDIA")

  dueDate DateTime?

  /// Quem abriu a demanda. Guardado como e-mail e nome, e não como vínculo com
  /// `User`, porque o card precisa continuar legível depois que a pessoa sai
  /// da empresa e a conta é removida.
  requesterEmail String?
  requesterName  String?

  /// A sigla do criador responsável — o mesmo vocabulário que liga um anúncio
  /// ao seu dono em `AdCreative.designer`. Ver `lib/designer-match.ts`.
  assigneeAcronym String?

  /// As respostas dos campos definíveis, em JSON, no mesmo espírito de
  /// `User.preferences`: o conjunto de campos muda com o quadro, e em colunas
  /// cada campo novo de cada time viraria uma migração.
  values String? @db.Text

  /// "FORM" (aberta no formulário) ou "COPY" (nasceu do gerador de copy).
  origin String @default("FORM")

  /// O texto gerado pela IA, quando a demanda veio do gerador.
  copyText String? @db.Text

  /// O link da demanda — a pasta do Drive com as artes.
  ///
  /// Coluna própria, e não mais um campo definível: todo card tem um, o quadro
  /// o mostra na frente e ele abre com um clique. Ver `lib/card-link.ts`.
  linkUrl String? @db.Text

  /// Referências anexadas, em JSON: `[{url,name,size,uploadedAt}]`.
  ///
  /// O arquivo mora no servidor externo (o mesmo cPanel da arte dos criativos);
  /// aqui fica só o endereço. Ver `lib/attachments.ts`.
  attachments String? @db.Text

  archived    Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  board      Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column     BoardColumn    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  activities CardActivity[]

  @@index([boardId, archived])
  @@index([columnId])
}

/// O histórico do card: criação, movimentações e comentários.
///
/// É o "acompanhamento" — sem ele, um card que voltou duas vezes de "Revisão"
/// chega ao fim parecendo igual a um que passou direto.
model CardActivity {
  id     String @id @default(cuid())
  cardId String

  /// CREATED, MOVED, UPDATED, ASSIGNED ou COMMENT.
  type String

  message String @db.Text

  authorEmail String?
  authorName  String?

  createdAt DateTime @default(now())

  card BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}
