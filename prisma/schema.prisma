generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model NewsInsight {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
}

model Creator {
  id        String   @id @default(cuid())
  name      String
  acronym   String   @unique
  active    Boolean  @default(true)
  monthlyGoal Float  @default(50000)
  monthlyVolumeGoal Int @default(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reports     CreatorMonthlyReport[]
  deliveries  Delivery[]
}

model CreatorMonthlyReport {
  id                String   @id @default(cuid())
  creatorId         String
  month             Int      // 1 a 12
  year              Int      // ex: 2026
  grossValue        Float    @default(0)
  riskApprovedValue Float    @default(0)
  spend             Float    @default(0)
  purchases         Int      @default(0)
  netOrders         Int      @default(0)
  roas              Float    @default(0)
  activeAdsCount    Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  creator           Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, month, year])
}

model Delivery {
  id        String   @id @default(cuid())
  slackTs   String   @unique // ID único da mensagem no Slack (timestamp)
  creatorId String
  pieces    Int
  date      DateTime
  text      String?  // A mensagem original do Slack
  createdAt DateTime @default(now())
  
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

model AlgorithmUpdate {
  id           String   @id @default(uuid())
  title        String
  content      String
  urgency      String   @default("Baixa")
  category     String   @default("Geral")
  sourceUrl    String?
  thumbnailUrl String?
  timestamp    DateTime @default(now())
  createdAt    DateTime @default(now())
}

model CampaignAnalysis {
  id        String   @id @default(uuid())
  title     String?
  resolved  Boolean  @default(false)
  items     String
  createdAt DateTime @default(now())
}

model AdCreative {
  id              String   @id
  adName          String
  adsetName       String
  campaignName    String
  designer        String?
  imageUrl        String?
  thumbnailUrl    String?
  videoUrl        String?
  mediaType       String   @default("image")
  publisherPlatforms String?
  status          String?
  createdTime     DateTime?
  metrics         AdDailyMetrics[]
}

model AdDailyMetrics {
  id              String   @id @default(uuid())
  adCreativeId    String
  date            DateTime
  spend           Float
  roas            Float
  cpm             Float
  ctr             Float
  cpc             Float    @default(0)
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  purchases       Int      @default(0)
  netOrders       Int      @default(0)
  riskApprovedValue Float  @default(0)
  grossValue      Float    @default(0)
  messages        Int      @default(0)
  creative        AdCreative @relation(fields: [adCreativeId], references: [id], onDelete: Cascade)

  @@unique([adCreativeId, date])
}

model SystemSettings {
  id                Int      @id @default(1)
  
  // Metas Gerais
  teamCreativeGoal  Int      @default(300)
  
  // Metas de Performance (ROAS / CPA)
  superWinnerSpend  Float    @default(1000)
  superWinnerReturn Float    @default(5000)
  superWinnerCpa    Float    @default(50)
  winnerSpend       Float    @default(1000)
  winnerReturn      Float    @default(1000)
  winnerCpa         Float    @default(60)
  hypothesisPrompt  String   @default("Você é um Diretor de Criação de Growth Marketing focado em conversão.\\nSua missão: Análise ULTRA CURTA e OBJETIVA sobre UM ÚNICO anúncio.\\n\\nDADOS:\\nAd: ${ad_name}\\nInvestimento: R$ ${spend}\\nAprovado: R$ ${riskApprovedValue}\\nCTR: ${ctr}%\\n\\nREGRA CRÍTICA 1: Seja EXTREMAMENTE objetivo, em formato de \\\"bullet points\\\" (máx 3). Vá direto ao ponto (MÁXIMO DE 300 PALAVRAS no total).\\nExemplo:\\n- **Copy:** Trocar \\\"Compre agora\\\" por \\\"Resolva o problema X\\\".\\n- **Visual:** O CTR baixo indica hook ruim. Mudar os primeiros 3 seg (se vídeo) ou a imagem de fundo.\\n\\nREGRA CRÍTICA 2: SEM INTRODUÇÕES. SEM CONCLUSÕES. SEM EXPLICAR OS NÚMEROS DE VOLTA. Apenas diga o que mudar ou testar.\\nREGRA CRÍTICA 3: É PROIBIDO usar <think> e responder em JSON. Use markdown.\\nSe investimento quase zero: \\\"Aguardando veiculação.\\\"")
  insightsPrompt    String   @default("Você é um DIRETOR DE CRIAÇÃO ORIENTADO A DADOS.\\n[DADOS (7 dias)]:\\n${JSON.stringify(topAds, null, 2)}\\n\\nSUA MISSÃO: Forneça insights ULTRA DIRETOS E OBJETIVOS para a equipe de design focando na conversão. Escolha os 3 criativos que mais chamaram atenção e liste 1 a 2 bullets curtos de melhoria para cada (MÁXIMO DE 300 PALAVRAS no total).\\n\\nREGRA CRÍTICA 1: NUNCA faça introduções. NUNCA faça textos longos. Vá direto à ação (Ex: \\\"Mudar o CTA\\\", \\\"Testar outro hook porque o CTR está ruim\\\").\\nREGRA CRÍTICA 2: É PROIBIDO dar conselhos de mídia (público, lance). Fale de design e copy.\\nREGRA CRÍTICA 3: ESTRITAMENTE EM TEXTO PURO (MARKDOWN) COM BULLETS. PROIBIDO usar JSON ou tags <think>.")
  andromedaPrompt   String   @default("Atue como um Diretor de Arte experiente.\\nEsses anúncios estão concorrendo entre si porque são muito parecidos visualmente.\\nNomes: ${creativeNames}\\nUm deles sugou a verba: ${cannibalizationRate}%\\n\\nINSTRUÇÃO ULTRA RÁPIDA PARA O DESIGNER: Diga EXATAMENTE o que mudar radicalmente para que pareçam anúncios totalmente diferentes.\\nMáximo de 2 frases.\\nRegra: Se tiver \\\"IMG\\\" no nome, NÃO fale de vídeo. Mande alterar fundo/cenário/cor.\\nREGRA CRÍTICA: SEM INTRODUÇÃO. DIRETO AO PONTO. Use Markdown. PROIBIDO tags <think>.")
  tavilySearchQuery String   @default("UGC hook variations, Direct response design teardown, Creative fatigue management, A/B test ad creative, estudos de caso de anúncios Meta Ads, hacks de retenção de atenção")
  marketInsightsPrompt String @default("Você é um Senior Creative Strategist e Especialista em Growth Marketing. Sua missão é buscar, analisar e compilar padrões de criativos (anúncios) de alta performance que geram impacto real em métricas de fundo de funil (CPA, ROAS, CPC, Thumbstop Ratio, CTR de saída).\\n\\nSeu Objetivo:\\nSempre que acionado, você deve encontrar \\\"hacks\\\", testes A/B validados e frameworks de anúncios nas informações pesquisadas e traduzir esses dados brutos em insights práticos e acionáveis para o nosso time de design, edição de vídeo e copywriting.\\n\\nRegras de Filtragem (O que você DEVE ignorar):\\n- Ignore artigos de topo de funil genéricos (ex: \\\"As 10 melhores cores para anúncios\\\").\\n- Ignore qualquer insight que não esteja atrelado a uma hipótese testada ou a uma métrica de performance clara.\\n- SE O CONTEÚDO FOR APENAS UMA NOTÍCIA, UM RESUMO, OU NÃO CONTIVER UM HACK/INSIGHT CLARO E APLICÁVEL DE CRIATIVOS, RESPONDA APENAS COM A PALAVRA: IGNORAR. Não tente inventar um hack se ele não existir no texto.\\n- É PROIBIDO o uso de JSON no retorno final.\\n\\nFormato de Saída (Como você deve entregar o resultado):\\nCompile seus achados e gere para CADA insight a seguinte estrutura EXATA em formato Markdown:\\n\\n## 🔥 O Hack / Insight Central\\n[Resumo em uma frase do que foi descoberto e por que funciona psicologicamente ou visualmente]\\n\\n**📊 Métricas Impactadas:** [Quais taxas este criativo visa melhorar (Ex: Aumenta Thumbstop, Reduz CPA)]\\n\\n**🛠️ O Teardown (Análise das Partes):**\\n- **Hook (Primeiros 3s):** [O que prende a atenção?]\\n- **Body (Retenção):** [Como o valor/problema é apresentado?]\\n- **CTA (Ação):** [Qual é o gatilho de conversão?]\\n\\n**🎯 Ordem de Execução para o Time:**\\n[Descreva um passo a passo prático de como nosso time de design/vídeo pode replicar esse framework hoje nos nossos próprios produtos]\\n\\n**🔗 Fontes/Referências:** [Liste os links ou os termos de busca que validaram este estudo]\\n\\nREGRA CRÍTICA: Responda ESTRITAMENTE EM TEXTO PURO (MARKDOWN) e 100% EM PORTUGUÊS (PT-BR), não importa o idioma original da fonte. É ESTRITAMENTE PROIBIDO retornar JSON. Use títulos (##) e os emojis conforme o modelo acima.")
  
  metaAdAccountId   String?
  metaAccessToken   String?
  geminiApiKey      String?
  openaiApiKey      String?
  anthropicApiKey   String?
  tavilyApiKey      String?
  groqApiKey        String?
  openRouterApiKey  String?
  cohereApiKey      String?
  huggingFaceApiKey String?
  slackBotToken     String?
  slackChannelId    String?
  
  cronSyncEnabled   Boolean  @default(true)
  cronSyncMode      String   @default("metrics") // "metrics" ou "full"
  cronSyncInterval  Int      @default(120)       // Intervalo em minutos

  lastSyncAt        DateTime?
  lastFastSyncAt    DateTime?
  lastDeepSyncAt    DateTime?
  lastCronSyncAt    DateTime?
  updatedAt         DateTime @updatedAt
}
