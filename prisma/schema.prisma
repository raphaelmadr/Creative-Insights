generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model NewsInsight {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
}

model Creator {
  id        String   @id @default(cuid())
  name      String
  acronym   String   @unique
  active    Boolean  @default(true)
  avatarUrl String?  @db.Text
  monthlyGoal Float  @default(50000)
  monthlyVolumeGoal Int @default(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reports     CreatorMonthlyReport[]
  deliveries  Delivery[]
}

model CreatorMonthlyReport {
  id                String   @id @default(cuid())
  creatorId         String
  month             Int      // 1 a 12
  year              Int      // ex: 2026
  grossValue        Float    @default(0)
  riskApprovedValue Float    @default(0)
  spend             Float    @default(0)
  purchases         Int      @default(0)
  netOrders         Int      @default(0)
  roas              Float    @default(0)
  activeAdsCount    Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  creator           Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, month, year])
}

model Delivery {
  id        String   @id @default(cuid())
  slackTs   String   @unique // ID único da mensagem no Slack (timestamp)
  creatorId String
  pieces    Int
  date      DateTime
  text      String?  @db.Text // A mensagem original do Slack
  createdAt DateTime @default(now())
  
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

model AlgorithmUpdate {
  id           String   @id @default(uuid())
  title        String
  content      String   @db.Text
  urgency      String   @default("Baixa")
  category     String   @default("Geral")
  sourceUrl    String?
  thumbnailUrl String?
  timestamp    DateTime @default(now())
  createdAt    DateTime @default(now())
}

model CampaignAnalysis {
  id        String   @id @default(uuid())
  title     String?
  resolved  Boolean  @default(false)
  items     String
  createdAt DateTime @default(now())
}

model AdCreative {
  id              String   @id
  adName          String
  adsetName       String
  campaignName    String
  designer        String?
  imageUrl        String?  @db.Text
  thumbnailUrl    String?  @db.Text
  videoUrl        String?  @db.Text
  mediaType       String   @default("image")
  publisherPlatforms String?
  platform        String   @default("META") // "META", "TIKTOK", "GOOGLE"
  status          String?
  createdTime     DateTime?
  metrics         AdDailyMetrics[]
}

model AdDailyMetrics {
  id              String   @id @default(uuid())
  adCreativeId    String
  date            DateTime
  spend           Float
  roas            Float
  cpm             Float
  ctr             Float
  cpc             Float    @default(0)
  impressions     Int      @default(0)
  reach           Int      @default(0)
  frequency       Float    @default(0)
  clicks          Int      @default(0)
  purchases       Int      @default(0)
  netOrders       Int      @default(0)
  riskApprovedValue Float  @default(0)
  grossValue      Float    @default(0)
  messages        Int      @default(0)
  creative        AdCreative @relation(fields: [adCreativeId], references: [id], onDelete: Cascade)

  @@unique([adCreativeId, date])
}

model SystemSettings {
  id                Int      @id @default(1)
  
  // Metas Gerais
  teamCreativeGoal  Int      @default(300)
  
  // Metas de Performance (ROAS / CPA)
  superWinnerSpend  Float    @default(1000)
  superWinnerReturn Float    @default(5000)
  superWinnerCpa    Float    @default(50)
  winnerSpend       Float    @default(1000)
  winnerReturn      Float    @default(1000)
  winnerCpa         Float    @default(60)
  hypothesisPrompt  String?  @db.Text
  insightsPrompt    String?  @db.Text
  andromedaPrompt   String?  @db.Text
  tavilySearchQuery String?  @db.Text
  marketInsightsPrompt String? @db.Text
  
  metaAdAccountId   String?
  metaAppId         String?
  metaAppSecret     String?  @db.Text
  metaAccessToken   String?  @db.Text
  
  tiktokAdvertiserId String?
  tiktokAppId        String?
  tiktokAppSecret    String? @db.Text
  tiktokAccessToken  String? @db.Text
  
  googleClientId    String?  @db.Text
  googleClientSecret String? @db.Text
  nextAuthSecret    String?  @db.Text
  nextAuthUrl       String?
  
  geminiApiKey      String?  @db.Text
  openaiApiKey      String?  @db.Text
  anthropicApiKey   String?  @db.Text
  tavilyApiKey      String?  @db.Text
  groqApiKey        String?  @db.Text
  openRouterApiKey  String?  @db.Text
  cohereApiKey      String?  @db.Text
  huggingFaceApiKey String?  @db.Text
  slackBotToken     String?
  slackChannelId    String?
  
  cpanelUploadUrl   String?  @db.Text
  cpanelUploadSecret String? @db.Text
  
  cronSyncEnabled   Boolean  @default(true)
  cronSyncMode      String   @default("metrics") // "metrics" ou "full"
  cronSyncInterval  Int      @default(120)       // Intervalo em minutos

  lastSyncAt        DateTime?
  lastFastSyncAt    DateTime?
  lastDeepSyncAt    DateTime?
  lastCronSyncAt    DateTime?
  updatedAt         DateTime @updatedAt
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String   // "INFO", "WARNING", "ERROR"
  source    String   // "FRONTEND", "BACKEND", "CRON", "SYNC", etc.
  message   String   @db.Text
  stack     String?  @db.Text
  url       String?  // A URL onde o erro ocorreu (se aplicável)
  createdAt DateTime @default(now())
}
